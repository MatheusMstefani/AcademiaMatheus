{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DEV09 e DEV10 - Abrir aplicativo",
      "type": "process", "command": "dotnet",
      "args": ["run", "--project", "AcademiaDoZe.Presentation.AppMaui", "-f", "net10.0-windows10.0.19041.0"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    },
    {
      "label": "DEV08 - Testes da Aplicacao",
      "type": "process", "command": "dotnet",
      "args": ["test", "AcademiaDoZe.Application.Tests", "--verbosity", "normal"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    },
    {
      "label": "DEV05 - Testes de Logradouro",
      "type": "process", "command": "dotnet",
      "args": ["test", "AcademiaDoZe.Infrastructure.Tests", "--filter", "FullyQualifiedName~LogradouroInfrastructureTests", "--verbosity", "normal"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    },
    {
      "label": "DEV06 - Testes de Aluno",
      "type": "process", "command": "dotnet",
      "args": ["test", "AcademiaDoZe.Infrastructure.Tests", "--filter", "FullyQualifiedName~AlunoInfrastructureTests", "--verbosity", "normal"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    },
    {
      "label": "DEV06 - Testes de Colaborador",
      "type": "process", "command": "dotnet",
      "args": ["test", "AcademiaDoZe.Infrastructure.Tests", "--filter", "FullyQualifiedName~ColaboradorInfrastructureTests", "--verbosity", "normal"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    },
    {
      "label": "DEV07 - Testes de Matricula",
      "type": "process", "command": "dotnet",
      "args": ["test", "AcademiaDoZe.Infrastructure.Tests", "--filter", "FullyQualifiedName~MatriculaInfrastructureTests", "--verbosity", "normal"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile"
    }
  ]
}
